APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-16-character-app-password"
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GHN_BASE_URL=https://online-gateway.ghn.vn
GHN_TOKEN=
GHN_SHOP_ID=
GHN_VERIFY_SSL=true
GHN_FROM_DISTRICT_ID=
GHN_SERVICE_TYPE_ID=2
GHN_PAYMENT_TYPE_ID=2
GHN_REQUIRED_NOTE=CHOXEMHANGKHONGTHU
GHN_FROM_NAME="${APP_NAME}"
GHN_FROM_PHONE=0900000000
GHN_FROM_ADDRESS=
GHN_FROM_WARD_NAME=
GHN_FROM_DISTRICT_NAME=
GHN_FROM_PROVINCE_NAME=
GHN_PACKAGE_HEIGHT=20
GHN_PACKAGE_LENGTH=60
GHN_PACKAGE_WEIGHT=5000
GHN_PACKAGE_WIDTH=45

# MoMo Payment Gateway
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_VERIFY_SSL=false
MOMO_REDIRECT_URL=http://127.0.0.1:8000/payment/momo/callback
MOMO_IPN_URL=http://127.0.0.1:8000/payment/momo/ipn
